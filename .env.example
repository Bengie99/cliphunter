# ClipHunter environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else stays server-side.

# ---------------------------------------------------------------------------
# Phase 1 — Database & auth (Supabase)
# Leave both empty to run in DEMO MODE with local sample data.
# Find these in Supabase dashboard → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force demo mode even when Supabase keys are set ("demo" | unset)
# CLIPHUNTER_DATA_MODE=demo

# ---------------------------------------------------------------------------
# Phase 2 — Background workers & platform integrations (not used yet)
# ---------------------------------------------------------------------------
# Service role key bypasses RLS — server/worker use only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=

# Twitch Helix — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Kick — https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# TikTok (Research/Display API — requires approval)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (business accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---------------------------------------------------------------------------
# Future — AI features
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
