# ClipHunter environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else stays server-side.

# ---------------------------------------------------------------------------
# Phase 1 — Database & auth (Supabase)
# Leave both empty to run in DEMO MODE with local sample data.
# Find these in Supabase dashboard → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force demo mode even when Supabase keys are set ("demo" | unset)
# CLIPHUNTER_DATA_MODE=demo

# ---------------------------------------------------------------------------
# Phase 2 — Background workers & platform integrations (not used yet)
# ---------------------------------------------------------------------------
# Discovery (server / Vercel)
CRON_SECRET=

# Download helper (your PC only — `npm run worker`). Your normal app login;
# the helper signs in as you, so it can only touch your own data.
CLIPHUNTER_WORKER_EMAIL=
CLIPHUNTER_WORKER_PASSWORD=
# Optional: subtitle speech model (default "small"; "base" is ~2x faster, less accurate)
# CLIPHUNTER_WHISPER_MODEL=small
# Optional: website the helper tray icon opens (used by npm run build:helper)
# CLIPHUNTER_APP_URL=https://cliphunter-six.vercel.app
# Optional: where footage is saved (default: ./footage in the project folder)
# CLIPHUNTER_FOOTAGE_DIR=D:\ClipHunterootage

# Service role key bypasses RLS — server/worker use only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=

# Twitch Helix — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Kick — https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# TikTok (Research/Display API — requires approval)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (business accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---------------------------------------------------------------------------
# AI — YouTube title/description writer (Claude). console.anthropic.com → API Keys.
# Billed separately from a Claude Pro subscription.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
